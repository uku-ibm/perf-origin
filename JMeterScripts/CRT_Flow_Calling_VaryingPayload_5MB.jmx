      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="ReadPayloadFile">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
def payload = new File(vars.get(&quot;payloadFile&quot;)).getText(&quot;UTF-8&quot;)

payload = payload.replace(&quot;\\\\&quot;, &quot;\\\\\\\\&quot;)
payload = payload.replace(&quot;\&quot;&quot;, &quot;\\\\\&quot;&quot;)
payload = payload.replace(&quot;\r&quot;, &quot;&quot;)
payload = payload.replace(&quot;\n&quot;, &quot;&quot;)

vars.put(&quot;payloadData&quot;, payload)

log.info(&quot;FINAL PAYLOAD LENGTH = &quot; + payload.length())
</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
